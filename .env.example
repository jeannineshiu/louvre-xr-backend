OPENAI_API_KEY=your_openai_api_key_here
PORT=8000

# Sophie TTS voice — uses OpenAI TTS (no extra API key needed)
# Options: alloy | echo | fable | onyx | nova | shimmer
SOPHIE_VOICE=nova

# Optional — error tracking (Sentry). Leave unset to disable entirely (local
# dev doesn't need it). Get a DSN from sentry.io > Project Settings > Client Keys.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional — Redis-backed rate limiting, shared across replicas. Leave unset
# to use in-memory rate limiting (fine for a single replica / local dev).
# REDIS_URL=redis://default:password@host:6379/0

# Optional — enables the OpenAI-compatible /v1 API for third-party chat clients
# (see README > OpenAI-Compatible API) and doubles as its bearer token. Leave
# unset to keep /v1/* switched off. Generate with: openssl rand -hex 24
# PARTNER_API_KEY=

# Optional — override the default per-endpoint rate limits (slowapi syntax).
# ASK_RATE_LIMIT=20/hour
# TRANSCRIBE_RATE_LIMIT=30/hour
# SESSION_RATE_LIMIT=30/hour
# PARTNER_RATE_LIMIT=120/hour
