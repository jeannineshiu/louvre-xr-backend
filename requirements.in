# ContextAR — Python 3.10 (conda env: contextar)
#
# Source file for requirements.txt. Edit this, then regenerate the fully
# pinned + hashed lockfile with:
#   pip-compile --generate-hashes --output-file=requirements.txt requirements.in
# Install with: pip install -r requirements.txt (hashes are verified automatically
# once any package in the file has one — see pip's --require-hashes behavior).

# Web server
fastapi==0.135.3
uvicorn==0.52.3
pydantic==2.13.4
python-multipart==0.0.31  # required by FastAPI for multipart/form-data (file uploads)
slowapi==0.1.10  # per-IP rate limiting, to cap public OpenAI usage
redis==8.1.0  # optional Redis backend for slowapi/limits, so rate limits are shared
              # across replicas instead of per-instance in-memory (see server.py)

# Observability
sentry-sdk[fastapi]==2.68.0  # error tracking; no-ops unless SENTRY_DSN is set (see server.py)

